# 키 목록만 둔다. 복사해서 .env로 쓰고 .env는 커밋하지 않는다 (CLAUDE.md §10).
# 운영에서는 ConfigMap(tetra-ops-api-config)·Secret(tetra-ops-api-secret)으로 같은 이름을 주입한다.

# ---- ConfigMap ----
TETRA_ENV=
AWS_REGION=
DB_URL=
SFN_APPROVE_STATE_MACHINE_ARN=
SFN_TENANT_STATE_MACHINE_ARN=
SQS_APPROVE_RESULT_QUEUE=
SQS_TENANT_RESULT_QUEUE=
MAIL_FROM=
PORTAL_BASE_URL=
CSV_PRESIGN_TTL=
API_DOCS_ENABLED=
TZ=Asia/Seoul

# ---- Secret ----
DB_USERNAME=
DB_PASSWORD=
OPS_JWT_SECRET=
PASSWORD_LINK_HMAC_SECRET=

# ---- 로컬 실행 전용 (dev-docs/로컬_실행.md). 운영에는 넣지 않는다 ----
# SPRING_PROFILES_ACTIVE=local          Step Functions 호출 생략, 메일은 build/local-mail/에 파일로
# SPRING_CLOUD_AWS_SQS_ENDPOINT=http://localhost:9324   SQS는 docker compose의 ElasticMQ
# AWS_ACCESS_KEY_ID=local / AWS_SECRET_ACCESS_KEY=local  ElasticMQ용 가짜 값
SPRING_PROFILES_ACTIVE=
SPRING_CLOUD_AWS_SQS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_MYSQL_ROOT_PASSWORD=
