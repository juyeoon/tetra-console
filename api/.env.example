# 키 목록만 둔다. 복사해서 .env로 쓰고 .env는 커밋하지 않는다 (CLAUDE.md §10).
# 운영에서는 ConfigMap(tetra-ops-api-config)·Secret(tetra-ops-api-secret)으로 같은 이름을 주입한다.

# ---- ConfigMap ----
TETRA_ENV=
AWS_REGION=
DB_URL=
SFN_APPROVE_STATE_MACHINE_ARN=
SFN_TENANT_STATE_MACHINE_ARN=
SQS_APPROVE_RESULT_QUEUE=
SQS_TENANT_RESULT_QUEUE=
# WF2-1 · WF2-2 · WF4 결과 큐(필수). 로컬은 event-lifecycle-result (docker/local/elasticmq.conf)
SQS_EVENT_LIFECYCLE_RESULT_QUEUE=
MAIL_FROM=
PORTAL_BASE_URL=
# 선택. 리포트 메일의 콘솔 화면 링크({값}/logs/reports). 비우면 메뉴 경로만
CONSOLE_BASE_URL=
# 선택. 비우면 tetraops.cloud (이벤트 도메인 {slug}.{tenant_id}.{이 값})
PLATFORM_DOMAIN=
CSV_PRESIGN_TTL=
API_DOCS_ENABLED=
# 선택. 홈 모니터링 카드(클러스터 · 트래픽 · 테넌트 처리 현황). 비우면 기동은 하고 카드만 값 없이(지연). ECS: http://prometheus.tetra.internal:9090
# 로컬: 포트 포워드 pf-prometheus(localhost:19090)가 열려 있으면 http://localhost:19090
PROMETHEUS_URL=
# 선택(기본값). 연결 2초 · 읽기 3초 · 캐시 15초 · 갱신 1회 전체 상한 8초 (ISO-8601 기간)
PROMETHEUS_CONNECT_TIMEOUT=
PROMETHEUS_READ_TIMEOUT=
MONITORING_CACHE_TTL=
MONITORING_REFRESH_TIMEOUT=
TZ=Asia/Seoul

# ---- Secret ----
DB_USERNAME=
DB_PASSWORD=
# 테넌트 등록 때 t_{tenant_id} 스키마를 만드는 DDL 계정 tetra_migrator (태스크 정의: 금고 tetra/{env}/db/migrator)
MIGRATOR_USERNAME=
MIGRATOR_PASSWORD=
OPS_JWT_SECRET=
PASSWORD_LINK_HMAC_SECRET=

# ---- 로컬 실행 전용 (dev-docs/로컬_실행.md). 운영에는 넣지 않는다 ----
# SPRING_PROFILES_ACTIVE=local          Step Functions 호출 생략, 메일은 build/local-mail/에 파일로
# SPRING_CLOUD_AWS_SQS_ENDPOINT=http://localhost:9324   SQS는 docker compose의 ElasticMQ
# AWS_ACCESS_KEY_ID=local / AWS_SECRET_ACCESS_KEY=local  ElasticMQ용 가짜 값
SPRING_PROFILES_ACTIVE=
SPRING_CLOUD_AWS_SQS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_MYSQL_ROOT_PASSWORD=
